{
    "id": "",
    "module_type": "delayOn",
    "category": "定时模块/延时开",
    "name": "延时开 (Delay On)",
    "description": "延时开模块用于在一定时间后启动后面的模块。当输入信号激活时，模块开始计时，经过设定的延时时间后输出激活信号。具体延时时间可为固定值或动态输入。",
    "keywords": [
        "延时开",
        "延时启动",
        "定时",
        "时间延迟"
    ],
    "usage_guides": [
        "配置延时时间和时间单位来设定启动延迟。",
        "可以选择延时时间是否由外部输入动态控制。",
        "当输入信号变为有效时开始计时，若在延时期间输入信号失效，则计时复位。",
        "计时结束后，输出端输出有效信号，启动后续逻辑。",
        "间隔时间单位可为秒、分、小时或天，每个单位的数值为整数。"
    ],
    "parameters_schema": {
        "timeout": {
            "type": "integer",
            "description": "延时启动的时长。",
            "minimum": 0,
            "default": 60
        },
        "timeoutFromInput": {
            "type": "boolean",
            "description": "延时时长是否由动态输入提供。",
            "default": false
        },
        "timeoutUnits": {
            "type": "string",
            "description": "延时时长的单位。",
            "enum": ["seconds", "minutes", "hours", "days"],
            "default": "seconds"
        },
        "inputsCount": {
        "type": "integer",
        "description": "动态输入时输入端口数量（范围 1~2）。",
        "minimum": 1,
        "maximum": 2,
        "default": 1
      }
    },
    "template_json": [
        {
            "id": "{{__GEN_ID__}}",
            "z": "{{__FLOW_ID__}}",
            "type": "delayOn",
            "name": "{{user_defined_name}}",
            "inputs": "{{inputsCount}}",
            "outputs": 1,
            "timeout": "{{timeout}}",
            "timeoutFromInput": "{{timeoutFromInput}}",
            "timeoutUnits": "{{timeoutUnits}}",
            "outOfService": 0,
            "outOfServiceValue": 0,
            "debugView": [
            {
                "n": "O1: ",
                "v": ""
            },
            {
                "n": "left:",
                "v": ""
            }
        ],
            "x": "{{xCoord}}",
            "y": "{{yCoord}}",
            "wires": "{{wiresArray}}"
        }
    ]
}