    {
        "id": "",
        "module_type": "hwOutput",
        "category": "变量模块/物理输出",
        "name": "物理输出 (Physical Output)",

        // --- 1. 检索与理解层 (供检索智能体使用) ---
        // 这部分内容将被转化为向量 (Vector)，用于匹配用户的自然语言需求
        "description": "物理输出模块用于创建控制器以及控制器 KONG 总线接入的 IO 扩展模块上具有输出功能的端口，实现对其进行配置并调用。",
        "keywords": [ "控制", "输出", "继电器", "接触器", "指示灯", "电磁阀", "变频器", "调光器", "阀门定位器", "执行机构", "记录仪", "电子膨胀阀", "DO", "模拟量输出", "通用输出", "线性变换", "默认值", "延迟开", "延迟关", "掉电保持"],
        "usage_guides": [],

        // --- 2. 参数约束层 (供规划智能体/LLM 填充参数使用) ---
        // 这部分定义了各个参数的合法取值，防止 AI 产生幻觉
        "parameters_schema": {
            "hwExpander": {
            "type": "integer",
            "description": "总线上的扩展模块地址。0 代表控制器本身 IO，1-31 代表总线上扩展IO模块地址。",
            "minimum": 0,
            "maximum": 31,
            "default": 0
            },
            "hwChannelIndex": {
            "type": "integer",
            "description": "IO通道的地址编号。",
            "minimum": 1,
            "maximum": 31,
            "default": 0
            },
            "user_defined_name": {
            "type": "string",
            "description": "实例名称",
            "default": "物理输出"
            }

        },

        "ports_definition": {
            "inputs":[
                {
                    "index": 0,
                    "label":"输入",
                    "type":"number",
                    "description":"实例目标赋值",
                    "condition":"always"
                },
                {
                    "index": 1,
                    "label":"使能输入",
                    "type":"integer",
                    "description":"使能控制实例对象的赋值;为0时,输入值不赋值至输出;为1或非0数值,把输入的值赋值至输出;端口未连接按1处理",
                    "condition":"always"
                }

            ],
            "outputs":[
                {
                    "index": 0,
                    "label":"输出",
                    "type":"number",
                    "description":"实例的值;信号为开关输入时,输出为布尔值;信号不为开关输出时,输出为数值",
                    "condition":"always"

                },
                {
                    "index": 1,
                    "label":"当前优先级",
                    "type":"unsigned integer",
                    "description":"BACnet激活时,输出该对象的CurrentPriority,范围0-16;BACnet不激活,隐藏该端口",
                    "condition":"当bacnetVisible为true时激活"

                }
            ]

        },

        // --- 3. 生成模板层 (最终产出的代码) ---
        // 规划智能体将填好的参数代入此模板
        // 注意：id, x, y, z, wires 这些拓扑参数留空或设为占位符，由规划智能体在连线时动态生成

         "template_json": {

        //需要AI填入
        "id":  "{{__GEN_ID__}}",//特殊标记，指示系统生成唯一 ID
        "z": "{{__FLOW_ID__}}",//特殊标记，指示归属的流程 ID
        "name": "{{user_defined_name}}",
        "hwExpander": "{{hwExpander}}",
        "hwChannelIndex": "{{hwChannelIndex}}",
        
        // 动态生成
        "x": 0, // 模块在流程图中的x坐标
        "y": 0,// 模块在流程图中的y坐标
        "wires": [],// 模块之间的连线
        "inputs": 0,// 模块的输入数量
        "outputs": 0,// 模块的输出数量
        
        // 以下为默认参数，不需要 AI 操心，直接硬编码
        "type": "hwOutput",
        "hwChannelType": "Universal Output",
        "hwOutputMode": "DO",
        "hwOutputDefault": 0,
        "hwOutputResolution": 0.1,
        "hwOutputConvert": "none",
        "hwOutputConvertLowLimit": 0,
        "hwOutputConvertHightLimit": 100,
        "hwOutputMinOnTime": 0,
        "hwOutputMinOfftime": 0,
        "bacnetVisible": false,
        "bacnetObjectType": "OBJECT_DISABLED",
        "bacnetObjectInstanceAuto": true,
        "bacnetObjectInstance": 1,
        "bacnetObjectPrefix": "",
        "bacnetObjectDescription": "",
        "bacnetObjectUnits": "No Units",
        "bacnetObjectPolarity": 0,
        "bacnetObjectCOV": false,
        "bacnetObjectCOVInscreace": 0.1,
        "hwOutputPriority": "16",
        "outOfService": 0,
        "outOfServiceValue": 0,
        "powerDownSave": false,
        "modbusSlaveEnable": false,
        "modbusSlaveRegAddr": 0,
        "modbusSlaveRegType": "0",
        "modbusSlaveRtuConvert": "none",
        "modbusSlaveRtuConvertScale": 1,
        "modbusSlave2Enable": false,
        "modbusSlave2RegAddr": 0,
        "modbusSlave2RegType": "0",
        "modbusSlave2RtuConvert": "none",
        "modbusSlave2RtuConvertScale": 1,
        "modbusTcpSlaveEnable": false,
        "modbusTcpSlaveRegAddr": 0,
        "modbusTcpSlaveRegType": "0",
        "modbusSlaveTcpConvert": "none",
        "modbusSlaveTcpConvertScale": 1

    }
}

