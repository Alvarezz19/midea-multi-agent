    {
        "id": "",
        "module_type": "hwInput",
        "category": "变量模块/物理输入",
        "name": "物理输入 (Physical Input)",

        // --- 1. 检索与理解层 (供检索智能体使用) ---
        // 这部分内容将被转化为向量 (Vector)，用于匹配用户的自然语言需求
        "description": "物理输入模块用于读取硬件设备的端口信号。它可以连接各种传感器（如温度、湿度、CO2）或开关量设备。根据硬件配置，支持读取数字量状态(DI)、模拟量电压(0-10V)、模拟量电流(4-20mA)以及各种电阻型温度传感器(NTC/PT/NI)。",
        "keywords": [ "采集", "读取", "传感器", "探头", "开关状态", "DI", "温度监测", "湿度监测", "CO2浓度", "模拟量输入", "通用输入", "电压信号", "电流信号", "热敏电阻", "铂电阻", "镍电阻", "BACnet", "线性变换", "线阻补偿", "内部状态监测"]
        "usage_guides": [],

        // --- 2. 参数约束层 (供规划智能体/LLM 填充参数使用) ---
        // 这部分定义了各个参数的合法取值，防止 AI 产生幻觉
        "parameters_schema": {
            "hwExpander": {
            "type": "integer",
            "description": "扩展模块地址。0 代表主控自身 IO，1-31 代表扩展模块地址。",
            "minimum": 0,
            "maximum": 31,
            "default": 0
            },
            "hwChannelIndex": {
            "type": "integer",
            "description": "硬件通道索引（端口号）。对应设备上的 UI1, UI2 等。",
            "minimum": 0,
            "maximum": 31,
            "default": 0
            },
            "user_defined_name": {
            "type": "string",
            "description": "该模块的名称",
            "default": "物理输入"
            }

        },

        // --- 3. 生成模板层 (最终产出的代码) ---
        // 规划智能体将填好的参数代入此模板
        // 注意：id, x, y, z, wires 这些拓扑参数留空或设为占位符，由规划智能体在连线时动态生成

         "template_json": {

        //需要AI填入
        "id":  "{{__GEN_ID__}}",//特殊标记，指示系统生成唯一 ID
        "z": "{{__FLOW_ID__}}",//特殊标记，指示归属的流程 ID
        "name": "{{user_defined_name}}",
        "hwExpander": "{{hwExpander}}",
        "hwChannelIndex": "{{hwChannelIndex}}",
        
        // 动态生成
        "x": 0, // 模块在流程图中的x坐标
        "y": 0,// 模块在流程图中的y坐标
        "wires": [],// 模块之间的连线
        "inputs": 0,// 模块的输入数量
        "outputs": 0,// 模块的输出数量
        
        // 以下为默认参数，不需要 AI 操心，直接硬编码
        "type": "hwInput",
        "hwChannelType": "Universal Input",
        "hwInputMode": "DI",
        "hwInputDefault": 0,
        "hwInputResolution": 0.1,
        "hwInputConvert": "none",
        "hwInputConvertLowLimit": 0,
        "hwInputConvertHightLimit": 100,
        "bacnetVisible": false,
        "bacnetObjectType": "OBJECT_DISABLED",
        "bacnetObjectInstanceAuto": true,
        "bacnetObjectInstance": 1,
        "bacnetObjectPrefix": "",
        "bacnetObjectDescription": "",
        "bacnetObjectUnits": "No Units",
        "bacnetObjectPolarity": 0,
        "bacnetObjectCOV": false,
        "bacnetObjectCOVInscreace": 0.1,
        "outOfService": 0,
        "outOfServiceValue": 0,
        "modbusSlaveEnable": false,
        "modbusSlaveRegAddr": 0,
        "modbusSlaveRegType": "0",
        "modbusSlaveRtuConvert": "none",
        "modbusSlaveRtuConvertScale": 1,
        "modbusSlave2Enable": false,
        "modbusSlave2RegAddr": 0,
        "modbusSlave2RegType": "0",
        "modbusSlave2RtuConvert": "none",
        "modbusSlave2RtuConvertScale": 1,
        "modbusTcpSlaveEnable": false,
        "modbusTcpSlaveRegAddr": 0,
        "modbusTcpSlaveRegType": "0",
        "modbusSlaveTcpConvert": "none",
        "modbusSlaveTcpConvertScale": 1,
        "hwInputResComp": 0

    }
}