    {
        "id": "",
        "module_type": "constInput",
        "category": "变量模块/常量",
        "name": "常量(常量输入)",

        // --- 1. 检索与理解层 (供检索智能体使用) ---
        // 这部分内容将被转化为向量 (Vector)，用于匹配用户的自然语言需求
        "description": "常量模块用于在控制系统中定义和管理固定不变的数值或状态。常量在程序运行过程中不会发生变化，适用于配置固定参数、预设值或基准值等应用场景。",
        "keywords": ["常量", "固定数值", "状态", "固定参数", "预设值", "基准值"],
        "usage_guides": [],

        // --- 2. 参数约束层 (供规划智能体/LLM 填充参数使用) ---
        // 这部分定义了各个参数的合法取值，防止 AI 产生幻觉
        "parameters_schema": {
            "user_defined_name": {
            "type": "string",
            "description": "该模块的名称",
            "default": "常量"
            },
            "fixedValue": {
            "type": "double",
            "description": "常量的具体值",
            "default": 0
            }

        },

        // --- 3. 生成模板层 (最终产出的代码) ---
        // 规划智能体将填好的参数代入此模板
        // 注意：id, x, y, z, wires 这些拓扑参数留空或设为占位符，由规划智能体在连线时动态生成

         "template_json": {

        //需要AI填入
        "id":  "{{__GEN_ID__}}",//特殊标记，指示系统生成唯一 ID
        "z": "{{__FLOW_ID__}}",//特殊标记，指示归属的流程 ID
        "name": "{{user_defined_name}}",
        "fixedValue": "{{fixedValue}}",
        
        // 动态生成
        "x": 0, // 模块在流程图中的x坐标
        "y": 0,// 模块在流程图中的y坐标
        "wires": [],// 模块之间的连线
        "inputs": 0,// 模块的输入数量
        "outputs": 0,// 模块的输出数量
        
        // 以下为默认参数，不需要 AI 操心，直接硬编码
        "type": "constInput",
        "outOfService": 0,
        "outOfServiceValue": 0

    }
}


