# ==================== LLM 配置 ====================
# 当前推荐使用 DeepSeek；其他 provider 仍可由 config.py / model_manager.py 支持，但本项目示例只保留主路径。
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ==================== Embedding 配置 ====================
EMBEDDING_PROVIDER=siliconflow

BGE_MODEL_NAME=BAAI/bge-m3
BGE_DEVICE=cpu

SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
JINA_API_KEY=your_jina_api_key_here
JINA_MODEL=jina-embeddings-v2-base-zh

# ==================== 向量数据库配置 ====================
CHROMA_PERSIST_DIR=./outputs/chroma_db
CHROMA_COLLECTION_ATOMIC_MODULES=kong_modules_v1
CHROMA_COLLECTION_SUBFLOW_TEMPLATES=ahu_subflow_templates_v1
CHROMA_COLLECTION_SYSTEM_PATTERNS=ahu_system_patterns_v1
PHASE2_CHROMA_COLLECTION_OWNER=phase2_ahu_assets
AHU_PATTERN_LIBRARY_DIR=AHU程序/pattern_library

# ==================== 运行与调试配置 ====================
DEBUG=True
MAX_RETRY_TIMES=3

# ==================== Workflow API 运行态配置 ====================
WORKFLOW_CHECKPOINTER_BACKEND=sqlite
WORKFLOW_CHECKPOINT_DB_PATH=outputs/workflow_api/checkpoints.sqlite3
WORKFLOW_RUN_REPOSITORY_PATH=outputs/workflow_api/runs.json

# ==================== Analysis 配置 ====================
ANALYSIS_LLM_PROVIDER=
ANALYSIS_LLM_MODEL=
ANALYSIS_LLM_TEMPERATURE=0.2
ANALYSIS_LLM_TIMEOUT_S=30
ANALYSIS_MAX_AMBIGUITIES=5
ANALYSIS_MAX_ASSUMPTIONS=5

# ==================== LLM 增强配置（默认关闭） ====================
LLM_ENHANCEMENT_ENABLED=false
LLM_ENHANCEMENT_PROVIDER=deepseek
LLM_ENHANCEMENT_MODEL=
LLM_ENHANCEMENT_TEMPERATURE=0.1
LLM_ENHANCEMENT_TIMEOUT_S=20

ANALYSIS_USE_ENGINEERING_COMPILER=false
ANALYSIS_ENGINEERING_LLM_PROVIDER=
ANALYSIS_ENGINEERING_LLM_MODEL=
ANALYSIS_ENGINEERING_LLM_TIMEOUT_S=30

RETRIEVAL_USE_LLM_REWRITE=false
RETRIEVAL_LLM_PROVIDER=
RETRIEVAL_LLM_MODEL=
RETRIEVAL_LLM_MAX_QUERIES=8
RETRIEVAL_LLM_TIMEOUT_S=8

RETRIEVAL_USE_CROSS_ENCODER_RERANK=false
RETRIEVAL_RERANKER_PROVIDER=bge
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANK_TOP_N=50
RETRIEVAL_RERANK_BATCH_SIZE=16
RETRIEVAL_RERANK_TIMEOUT_S=20

ARCHITECTURE_USE_LLM_ADVISOR=false
ARCHITECTURE_LLM_PROVIDER=
ARCHITECTURE_LLM_MODEL=
ARCHITECTURE_LLM_TIMEOUT_S=20

SUBSYSTEM_USE_LLM_ADAPTER=false
SUBSYSTEM_LLM_PROVIDER=
SUBSYSTEM_LLM_MODEL=
SUBSYSTEM_LLM_TIMEOUT_S=30

# ==================== LangSmith 配置（可选） ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=midea
