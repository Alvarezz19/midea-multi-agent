# ==================== LLM 配置 ====================
# 选择 LLM 提供商: deepseek, openai, qwen, glm
LLM_PROVIDER=qwen

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 通义千问配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# 智谱 GLM 配置
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# Kimi 配置（Moonshot）
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5


# ==================== Embedding 配置 ====================
# 选择 Embedding 提供商: bge, siliconflow, openai, sentence-transformers, jina
EMBEDDING_PROVIDER=siliconflow

# BGE 配置（本地模型）
BGE_MODEL_NAME=BAAI/bge-m3
BGE_DEVICE=cpu

# 硅基流动配置（BGE-M3 API）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# OpenAI Embedding 配置
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Sentence Transformers 配置
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Jina Embedding 配置
JINA_API_KEY=your_jina_api_key_here
JINA_MODEL=jina-embeddings-v2-base-zh

# ==================== 向量数据库配置 ====================
CHROMA_PERSIST_DIR=./chroma_db

# ==================== 调试配置 ====================
DEBUG=True

# ==================== Workflow API 运行态配置 ====================
# 开发/联调默认使用 sqlite；单测或临时 demo 可改为 memory
WORKFLOW_CHECKPOINTER_BACKEND=sqlite
WORKFLOW_CHECKPOINT_DB_PATH=outputs/workflow_api/checkpoints.sqlite3
WORKFLOW_RUN_REPOSITORY_PATH=outputs/workflow_api/runs.json

# ==================== 重试配置 ====================
MAX_RETRY_TIMES=3

# ==================== 温度参数配置 ====================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ==================== 检索智能体 LLM 优化（默认关闭） ====================
# 说明：用于在检索阶段可选启用 LLM 查询重写/轻量重排。
# 默认关闭，开启后也会在 LLM 不可用/超时/解析失败时自动回退。
RETRIEVAL_USE_LLM_REWRITE=false

# 可选：为检索优化指定独立的 provider/model；为空则复用上面的 LLM_PROVIDER/对应默认模型
# RETRIEVAL_LLM_PROVIDER=qwen
# RETRIEVAL_LLM_MODEL=qwen3-max
RETRIEVAL_LLM_PROVIDER=
RETRIEVAL_LLM_MODEL=

# 预算参数（与成本/延迟强相关）
RETRIEVAL_LLM_MAX_QUERIES=4
RETRIEVAL_LLM_TIMEOUT_S=8

# ==================== LangSmith 配置 ====================
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_PROJECT="midea"   # 可自定义项目名
